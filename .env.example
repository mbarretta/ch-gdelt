# Copy this file to .env for local functions-framework runs only.
# .env is gitignored and must never contain real credentials committed to git.
# In production, CLICKHOUSE_PASSWORD comes from GCP Secret Manager via --set-secrets,
# never from a .env file.
CLICKHOUSE_URL=https://REPLACE_ME.us-east1.gcp.clickhouse.cloud:8443
CLICKHOUSE_USER=REPLACE_ME
CLICKHOUSE_PASSWORD=REPLACE_ME
